{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:frontend": "node dist/frontend/server/server.mjs",
    "gen:sources": "tsx scripts/generate-sources.ts",
    "prestart": "npm run gen:sources",
    "prebuild": "npm run gen:sources",
    "runtime": "tsx server.ts",
    "dev": "concurrently --kill-others --names runtime,angular --prefix-colors magenta,cyan \"npm:runtime\" \"npm:start\""
  },
  "private": true,
  "packageManager": "npm@12.0.1",
  "dependencies": {
    "@ag-ui/client": "^0.0.57",
    "@angular/cdk": "^22.1.1",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.3",
    "@copilotkit/angular": "^0.3.1",
    "@copilotkit/runtime": "^1.67.1",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.3",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.19.43",
    "concurrently": "^10.0.4",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "rxjs": "$rxjs"
  }
}
